# LedgerX environment — copy to .env and fill in. NEVER commit .env.
#
# Supabase project (Dashboard → Settings → API). Only the public anon key and
# URL belong here — they are safe to ship to the browser because Row Level
# Security enforces per-user access. The service_role key must NEVER appear in
# any file, env var, or deployment.

# Project URL, e.g. https://abcdefghijklmno.supabase.co
VITE_SUPABASE_URL=

# Public anon key (the long "anon"/"publishable" JWT from the API settings page)
VITE_SUPABASE_ANON_KEY=

# LedgerX API Worker base URL (Hono on Cloudflare Workers).
#   local dev:   http://localhost:8787   (npx wrangler dev)
#   production:  https://ledgerx-api.<subdomain>.workers.dev   (after wrangler deploy)
VITE_API_URL=http://localhost:8787
